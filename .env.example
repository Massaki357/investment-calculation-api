# Copy to .env and adjust per environment. Never commit .env.

APP_NAME="Investment Calculation API"
# development | staging | production | test
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Comma-separated list of allowed origins. Empty = CORS disabled.
# Never use "*" in production.
CORS_ORIGINS=http://localhost:3000

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Optional. When set, every /api/* request must send header X-API-Key with this value.
# Leave empty to keep authentication disabled.
API_KEY=

# Docker Compose only: host port mapped to the container's port 8000.
HOST_PORT=8000

# Safety limits against CPU/memory abuse.
MAX_SERIES_LENGTH=100000
MAX_MONTE_CARLO_CELLS=10000000
